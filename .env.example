COMPANY_NAME=""
TWITTER_CREATOR=""
TWITTER_SITE=""
SITE_NAME=""
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_REVALIDATION_SECRET=

# SANITY
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Database (Vercel Postgres / Neon) — required by the admin panel
# Pooled connection string, used by the app at runtime.
# For the local docker-compose dev database (`pnpm db:reset`), use:
#   DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/dev
# The e2e suite ignores this and uses its own local test database.
DATABASE_URL=
# Direct (non-pooled) connection string, used only by drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# Admin panel — 32+ random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# ImageKit — server-side uploads for admin product photos
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# GoKwik
NEXT_PUBLIC_GOKWIK_MERCHANT_ID=""
NEXT_PUBLIC_GOKWIK_STORE_ID=""
NEXT_PUBLIC_GOKWIK_ENVIRONMENT=""
NEXT_PUBLIC_GOKWIK_FB_PIXEL=""
# Development only: the country to assume without Vercel geolocation. Set to IN
# to use GoKwik locally; unset, the site uses Shopify's checkout like an
# unlocated shopper would. Ignored in production builds.
NEXT_PUBLIC_GOKWIK_DEFAULT_COUNTRY=""

# Tracking — leave empty to disable. Values used by the old Shopify store:
#   GA4: G-QJBQZT2Y2S   Google Ads: AW-17352598190   Meta Pixel: 1234450115146850
#   Google tag: GT-PHP72LNC (routes to Merchant Center MC-S8WPHN7ZK4 + MC-KRJ68T4TY5)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_TAG_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
